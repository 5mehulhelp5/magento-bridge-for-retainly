<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_order_place_after">
        <observer name="retnly_order_placed"
                  instance="Retnly\MagentoBridge\Observer\OrderPlacedObserver"/>
    </event>
    <event name="sales_order_invoice_pay">
        <observer name="retnly_order_paid"
                  instance="Retnly\MagentoBridge\Observer\OrderPaidObserver"/>
    </event>
    <event name="sales_order_shipment_save_after">
        <observer name="retnly_order_fulfilled"
                  instance="Retnly\MagentoBridge\Observer\OrderFulfilledObserver"/>
    </event>
    <event name="sales_order_creditmemo_save_after">
        <observer name="retnly_order_refunded"
                  instance="Retnly\MagentoBridge\Observer\OrderRefundedObserver"/>
    </event>
    <!-- Magento\Sales\Model\Order::cancel() dispatches `order_cancel_after`.
         It is NOT `sales_order_cancel_after` — that event does not exist. -->
    <event name="order_cancel_after">
        <observer name="retnly_order_cancelled"
                  instance="Retnly\MagentoBridge\Observer\OrderCancelledObserver"/>
    </event>
    <!-- Keeps Retnly's catalogue copy fresh within a minute instead of a day.
         Both events carry the product, so one observer serves both. -->
    <event name="catalog_product_save_after">
        <observer name="retnly_product_saved"
                  instance="Retnly\MagentoBridge\Observer\ProductChangedObserver"/>
    </event>
    <event name="catalog_product_delete_after">
        <observer name="retnly_product_deleted"
                  instance="Retnly\MagentoBridge\Observer\ProductChangedObserver"/>
    </event>
    <event name="customer_register_success">
        <observer name="retnly_customer_registered"
                  instance="Retnly\MagentoBridge\Observer\CustomerRegisteredObserver"/>
    </event>
</config>
